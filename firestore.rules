rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users listed in house/main.allowedUids can read or write.
    // Add both UIDs to that document in Firebase Console before first use.
    function isHouseMember() {
      return request.auth != null &&
             request.auth.uid in get(/databases/$(database)/documents/house/main).data.allowedUids;
    }

    match /house/{houseId}/{document=**} {
      allow read, write: if isHouseMember();
    }
  }
}
